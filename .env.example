# Copy to .env and change values. Never commit .env.
APP_ENV=development
DATABASE_URL=sqlite:///./neuroshield.db
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING
JWT_EXPIRE_MINUTES=30
FRONTEND_ORIGIN=http://localhost:5173
ARTIFACTS_DIR=artifacts

# Optional. Set automatically in the Docker image. Serves the built frontend from the API (single-origin deployment).
# FRONTEND_DIST=frontend/dist
# Optional. Use PostgreSQL instead of SQLite (a postgres:// or postgresql:// URL from your host works as-is).
# DATABASE_URL=postgresql://user:password@host:5432/dbname
